{
  // Staging deliberately uses a different Worker from the live concept demo.
  // Use npm run deploy:production only after reviewing release readiness.
  "name": "pocketspace-quest-staging",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-16",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" }
    ]
  },
  "migrations": [
    { "tag": "pocketspace-v1", "new_sqlite_classes": ["Room"] }
  ]
}
